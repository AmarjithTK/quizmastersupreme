{
  "$schema": "node_modules/wrangler/config-schema.json",
  // M14 — staging environment: a SEPARATE worker name and D1 database so
  // staging traffic and data are fully isolated from production. Fill in the
  // real database_id after `wrangler d1 create quizmaster-supreme-db-staging`.
  // Deploy with: pnpm deploy:staging (requires `wrangler login`).
  "name": "quizmaster-supreme-staging",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizmaster-supreme-db-staging",
      // Placeholder. Replace with the UUID from `wrangler d1 create
      // quizmaster-supreme-db` before deploying. Local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ─── M10 — AI generation pipeline ────────────────────────────────────────
  // R2 archives every raw model response, so a bad batch can still be
  // diagnosed weeks later. Locally simulated by Wrangler, so this works under
  // `vinext dev` with nothing provisioned.
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "quizmaster-supreme-assets-staging" }
  ],

  "services": [
    { "binding": "GENERATION_ORCHESTRATOR", "service": "quizmaster-generation-workflow-staging" }
  ],

  // NOTE: deliberately NO Queue/Workflow export here. vinext owns the Worker entry
  // point (`vinext/server/fetch-handler` re-exports a virtual entry), so there
  // is nowhere to attach a `queue()` handler without replacing that entry.
  // point; the separate generation Worker imports the same domain services.
  // The admin UI drives bounded steps only in local/manual fallback mode.
  //
  // M12 — semantic dedupe (needs a Vectorize index and the Workers AI binding):
  // "vectorize": [{ "binding": "VECTORIZE", "index_name": "quizmaster-supreme-questions" }],
  // "ai": { "binding": "AI" },

  "vars": {
    "APP_ENV": "staging",
    "APP_BASE_URL": "https://staging.quizmastersupreme.app",
    "GOOGLE_CLIENT_ID": "",
    "ADMIN_EMAILS": "",
    "DEFAULT_GENERATION_MODEL": "deepseek/deepseek-v4-flash-0731",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
