{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizmaster-supreme",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  // ─── M0–M6 (v0.1): D1 is the only binding we need. ───────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizmaster-supreme-db",
      // Placeholder. Replace with the UUID from `wrangler d1 create
      // quizmaster-supreme-db` before deploying. Local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ─── M10 — AI generation pipeline ────────────────────────────────────────
  // R2 archives every raw model response, so a bad batch can still be
  // diagnosed weeks later. Locally simulated by Wrangler, so this works under
  // `vinext dev` with nothing provisioned.
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "quizmaster-supreme-assets" }
  ],

  // Separate Workflow-capable Worker: deploy it first, then this vinext Worker.
  // The binding is only dispatched when APP_ENV is production and the shared
  // GENERATION_ORCHESTRATION_TOKEN secret exists. Local dev stays manual.
  "services": [
    { "binding": "GENERATION_ORCHESTRATOR", "service": "quizmaster-generation-workflow" }
  ],

  // NOTE: deliberately NO Queue/Workflow export here. vinext owns the Worker entry
  // point (`vinext/server/fetch-handler` re-exports a virtual entry), so there
  // is nowhere to attach a `queue()` handler without replacing that entry.
  // point; the separate generation Worker imports the same domain services.
  // The admin UI drives bounded steps only in local/manual fallback mode.
  //
  // M12 — semantic dedupe (needs a Vectorize index and the Workers AI binding):
  // "vectorize": [{ "binding": "VECTORIZE", "index_name": "quizmaster-supreme-questions" }],
  // "ai": { "binding": "AI" },

  "vars": {
    "APP_ENV": "development",
    "APP_BASE_URL": "http://localhost:3000",
    "GOOGLE_CLIENT_ID": "",
    "ADMIN_EMAILS": "amarjith4097@gmail.com",
    "DEFAULT_GENERATION_MODEL": "deepseek/deepseek-v4.1-flash",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
